#!/bin/sh
# PrivateGit pre-receive hook (root-owned in /opt/privategit/hooks; runs for every SSH push
# through the gate). Branch deletion rules:
#   * the main (default) branch can never be deleted;
#   * a branch can be deleted only by the person who created it, or by an administrator;
#   * branches with no recorded creator (made before ownership tracking) only by an admin;
#   * tags are version labels and are never deleted.
# Force-push stays refused separately (receive.denyNonFastForwards).
main=$(git symbolic-ref -q HEAD 2>/dev/null || echo refs/heads/main)
user=${PRIVATEGIT_USER:-unknown}
admin=${PRIVATEGIT_ADMIN:-0}
status=0
while read -r old new ref; do
    case $new in *[!0]*) continue ;; esac          # not a deletion
    case $ref in
        "$main"|refs/heads/main)
            echo "PrivateGit: the main branch (${ref#refs/heads/}) cannot be deleted." >&2; status=1 ;;
        refs/tags/*)
            echo "PrivateGit: tag ${ref#refs/tags/} is a version label and cannot be deleted. Ask an administrator." >&2; status=1 ;;
        refs/heads/*)
            branch=${ref#refs/heads/}
            owner=$(git config --get "branch.$branch.privategitowner" 2>/dev/null)
            if [ "$admin" != 1 ] && [ "$owner" != "$user" ]; then
                echo "PrivateGit: branch $branch was created by ${owner:-an unknown user (before ownership tracking)}. Only its creator or an administrator can delete it." >&2
                status=1
            fi ;;
        *)
            echo "PrivateGit: deleting $ref is not allowed." >&2; status=1 ;;
    esac
done
exit $status
