@page "/repositories/{name}/versions"
@model VersionsModel
@{ ViewData["Title"] = "Versions · " + Model.Name; }
<a asp-page="/Repository" asp-route-name="@Model.Name" class="back">← @Model.Name</a>
<div class="eyebrow">REPOSITORY VERSIONS</div><h1>Branches &amp; tags</h1><p class="muted">Browse a branch or return to the code marked by a version tag. You can delete branches you created (administrators: any branch). The main branch is protected.</p>
<nav class="repo-tabs"><a asp-page="/Repository" asp-route-name="@Model.Name">Files &amp; history</a><a class="active" asp-page="/Versions" asp-route-name="@Model.Name">Branches &amp; tags</a><a asp-page="/Compare" asp-route-name="@Model.Name">Compare changes</a>@if (User.IsInRole("Admin")) { <a asp-page="/Access" asp-route-name="@Model.Name">Access</a> }</nav>
@if (Model.Message is not null) { <div class="notice success" role="status">@Model.Message</div> }
@if (Model.Error is not null) { <div class="notice error" role="alert">@Model.Error</div> }
<h2 class="history-title">Branches</h2><section class="file-panel">@foreach (var branch in Model.Branches) { <div class="version-row"><a asp-page="/Repository" asp-route-name="@Model.Name" asp-route-Revision="@("branch:" + branch.Name)"><strong>⑂ @branch.Name</strong></a><a asp-page="/Commit" asp-route-name="@Model.Name" asp-route-id="@branch.Commit"><code>@branch.Commit[..8]</code></a>@if (Model.Owners.TryGetValue(branch.Name, out var owner)) { <span class="small muted">created by @owner</span> }<span class="branch-actions"><a class="small" asp-page="/Compare" asp-route-name="@Model.Name" asp-route-After="@("branch:" + branch.Name)">Compare →</a>@if (branch.Name == Model.MainBranch || branch.Name == "main") { <span class="badge">Protected</span> }</span>@if (Model.MayDelete(branch.Name)) { <details class="delete-branch"><summary>Delete</summary><form method="post" asp-page-handler="Delete" asp-route-name="@Model.Name"><input type="hidden" name="DeleteBranch" value="@branch.Name"><input type="hidden" name="DeleteCommit" value="@branch.Commit"><p class="small">Delete <strong>@branch.Name</strong> from the server? Commits already merged elsewhere are kept; unmerged commits can be recovered by the admin for a while.</p><button class="danger">Delete branch @branch.Name</button></form></details> }</div> }@if (Model.Branches.Count == 0) { <p class="empty-history muted">No branches yet.</p> }</section>
<h2 class="history-title">Version tags</h2><p class="small muted">Up to 200 tags directly targeting commits (lightweight or annotated). Tag dates come from the tagger for annotated tags and the commit for lightweight tags. Tags are managed through Git; these are not separate uploaded release assets.</p>
<section class="file-panel">@foreach (var tag in Model.Tags) { <div class="version-row"><div><a asp-page="/Repository" asp-route-name="@Model.Name" asp-route-Revision="@("tag:" + tag.Name)"><strong>◇ @tag.Name</strong></a><p class="small muted">@tag.Subject<br><time datetime="@tag.Date">@tag.Date</time> · @(tag.Annotated ? "Annotated" : "Lightweight")</p></div><a asp-page="/Commit" asp-route-name="@Model.Name" asp-route-id="@tag.Commit"><code>@tag.Commit[..8]</code></a><a class="small" asp-page="/Compare" asp-route-name="@Model.Name" asp-route-After="@("tag:" + tag.Name)">Compare →</a></div> }@if (Model.Tags.Count == 0) { <p class="empty-history muted">No commit-targeted tags yet. Create and push a tag from your Git client.</p> }</section>
