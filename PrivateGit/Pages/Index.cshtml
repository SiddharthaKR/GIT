@page
@model IndexModel
@{ ViewData["Title"] = "Repositories"; }
<div class="eyebrow">ENGINEERING WORKSPACE</div><div class="page-title"><div><h1>Repositories</h1><p class="muted">A home for everything you’re building.</p></div><span class="network-pill"><span class="status-dot"></span> Private network</span></div>
<div class="stats"><div><span class="muted">Repositories shown</span><strong>@Model.Repositories.Count</strong></div><div><span class="muted">Visibility</span><strong class="stat-text">Private</strong></div><div><span class="muted">Git transport</span><strong class="stat-text">SSH keys</strong></div><div><span class="muted">Account protection</span><strong class="stat-text">Password + TOTP</strong></div></div>
<div class="content-grid"><section><form class="search" method="get"><input asp-for="Search" placeholder="Find a repository…" aria-label="Search repositories"><button class="secondary">Search</button></form><div class="section-heading">@(User.IsInRole("Admin") ? "All repositories" : "Your repositories") <span class="count">@Model.Repositories.Count</span></div>
@if (Model.Repositories.Count == 0) { <div class="empty"><span class="empty-icon">▤</span>@if (User.IsInRole("Admin")) { <h2>Your next project starts here.</h2><p class="muted">Create a repository, grant people access, then push your code over SSH.</p> } else { <h2>No repositories shared with you yet.</h2><p class="muted">Ask an administrator to grant you read or write access to a project.</p> }</div> }
@foreach (var repo in Model.Repositories) { <a class="repo-card" asp-page="/Repository" asp-route-name="@repo.Name"><div class="repo-icon">▤</div><div><h2>@repo.Name <span class="badge">@(User.IsInRole("Admin") ? "Admin" : Model.Permissions[repo.Name] == Permission.Write ? "Read & write" : "Read only")</span></h2><p class="muted">Browse files, branches, and recent commits</p><span class="small">Git repository <span class="dot-separator">·</span> SSH enabled</span></div><span class="arrow">↗</span></a> }
</section><aside class="right-panel">@if (User.IsInRole("Admin")) { <div class="panel"><div class="eyebrow">START SOMETHING NEW</div><h2>Create a repository</h2><p class="muted small">An empty remote with a main branch, ready for your first push.</p>@if (Model.Error is not null) { <div class="notice error" role="alert">@Model.Error</div> }<form method="post"><label asp-for="Name">Repository name</label><div class="input-suffix"><input asp-for="Name" placeholder="my-project" required maxlength="63"><span>.git</span></div><p class="small muted">Lowercase letters, numbers, _ and -. Start with a letter.</p><button class="primary full">+ Create repository</button></form></div> }<div class="panel subtle"><h2>Built for your network.</h2><p class="small muted">Clone from Linux or Windows using the same SSH remote. Your repositories stay on your server.</p><div class="small">● &nbsp; Authenticated browsing</div><div class="small">● &nbsp; Per-user repository permissions</div><div class="small">● &nbsp; Git over SSH</div></div></aside></div>
